@using Microsoft.AspNetCore.Components.QuickGrid
@using Mmu.CleanBlazor.Application.Areas.Individuals.UseCases.LoadOverview.Response
@using Mmu.CleanBlazor.Presentation2.Areas.Individuals.Overview
@using Mmu.CleanBlazor.Presentation2.Shared.Components.QuickGrids.Filtering.Filters
@using Mmu.CleanBlazor.Presentation2.Shared.Components.QuickGrids

<div class="quickgrid-main">
    <div class="table-responsive">
        <QuickGrid ItemKey="f => f.IndividualId"
                   Pagination="@Pagination"
                   TGridItem="IndividualOverviewEntry"
                   ItemsProvider="GetItemsAsync"
                   Class="table table-striped table-hover table-bordered has-row-click">

            <PropertyColumn Title="Firstname" Property="@(p => p.FirstName)" Sortable="true" Class="@FirstNameFilter.CssClass">
                <ColumnOptions>
                    <div class="search-box">
                        <input type="search" class="form-control" autofocus @bind="FirstNameFilter.Value" @bind:event="oninput" />
                    </div>
                </ColumnOptions>
            </PropertyColumn>

            <PropertyColumn Title="Lastname" Property="@(p => p.LastName)" Sortable="true" Class="@LastNameFilter.CssClass">
                <ColumnOptions>
                    <div class="search-box">
                        <input type="search" class="form-control" autofocus @bind="LastNameFilter.Value" @bind:event="oninput" />
                    </div>
                </ColumnOptions>
            </PropertyColumn>
        </QuickGrid>
    </div>

    <PageSizeChooser @bind-ItemsPerPage="@Pagination.ItemsPerPage" />
    <AppPaginator State="@Pagination" />
</div>
